{
  "name": "mhw-log-viewer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web viewer for MHW DPS Meter fight logs (SolidJS 2, TanStack Table + Charts, daisyUI)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.6",
    "@tanstack/charts": "0.16.0",
    "@tanstack/table-core": "9.2.4",
    "solid-js": "2.0.0-rc.6"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.27",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "daisyui": "^5.7.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  }
}
